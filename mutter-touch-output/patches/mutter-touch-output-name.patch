diff --git a/src/backends/native/meta-input-device-native.c b/src/backends/native/meta-input-device-native.c
index 51b627f4a7..c86243b590 100644
--- a/src/backends/native/meta-input-device-native.c
+++ b/src/backends/native/meta-input-device-native.c
@@ -221,6 +221,27 @@ meta_input_device_native_get_dimensions (ClutterInputDevice *device,
   return FALSE;
 }
 
+const char *
+meta_input_device_native_get_output_name (ClutterInputDevice *device)
+{
+  MetaInputDeviceNative *device_native = META_INPUT_DEVICE_NATIVE (device);
+  const char *name;
+
+  if (!device_native->libinput_device)
+    {
+      g_warning ("TOUCH_OUTPUT: no libinput_device for '%s'",
+                 clutter_input_device_get_device_name (device));
+      return NULL;
+    }
+
+  name = libinput_device_get_output_name (device_native->libinput_device);
+
+  g_warning ("TOUCH_OUTPUT: device '%s' -> WL_OUTPUT='%s'",
+             clutter_input_device_get_device_name (device),
+             name ? name : "(null)");
+  return name;
+}
