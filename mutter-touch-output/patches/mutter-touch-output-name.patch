   META_MATCH_EDID_FULL,    /* Full EDID model match, eg. "Cintiq 12WX" */
   META_MATCH_SIZE,         /* Size from input device and output match */
   META_MATCH_IS_BUILTIN,   /* Output is builtin, applies mainly to system-integrated devices */
+  META_MATCH_OUTPUT_NAME,  /* Output name provided by libinput/udev */
   META_MATCH_CONFIG,       /* Specified by config */
   N_OUTPUT_MATCHES
 } MetaOutputMatchType;
@@ -392,6 +394,36 @@ match_builtin (MetaInputMapper *mapper,
   return monitor == meta_monitor_manager_get_builtin_monitor (mapper->monitor_manager);
 }
 
+static gboolean
+match_output_name (MetaMapperInputInfo *input,
+                   MetaMonitor         *monitor)
+{
+  const char *output_name;
+  MetaOutput *output;
+
+  if (!META_IS_INPUT_DEVICE_NATIVE (input->device))
+    {
+      g_warning ("TOUCH_OUTPUT: '%s' is not a native device",
+                 clutter_input_device_get_device_name (input->device));
+      return FALSE;
+    }
+
+  output_name = meta_input_device_native_get_output_name (input->device);
+  if (!output_name)
+    {
+      g_warning ("TOUCH_OUTPUT: output_name NULL for '%s'",
+                 clutter_input_device_get_device_name (input->device));
+      return FALSE;
+    }
+
+  output = meta_monitor_get_main_output (monitor);
+
+  g_warning ("TOUCH_OUTPUT: '%s' WL_OUTPUT='%s' vs monitor='%s'",
+             clutter_input_device_get_device_name (input->device),
+             output_name, meta_output_get_name (output));
+  return g_strcmp0 (meta_output_get_name (output), output_name) == 0;
+}
